# CareerPilot AI configuration template.
# Copy to .env and fill in values. Never commit .env. `make env` generates random secrets.

# ---- General ----
APP_ENV=development            # development | test | production (production enforces all secrets)
APP_VERSION=dev
LOG_LEVEL=info                 # debug | info | warn | error

# ---- Host ports (ADR-013) ----
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
API_HOST_PORT=8080
AI_HOST_PORT=8090
WEB_HOST_PORT=8088

# ---- PostgreSQL ----
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=careerpilot
# Used when running the API on the host (make dev-api):
DATABASE_URL=postgres://careerpilot:change-me@localhost:55432/careerpilot?sslmode=disable
DATABASE_MAX_CONNS=10

# ---- Redis (rate limits, caches; never authoritative) ----
REDIS_URL=redis://localhost:56379/0

# ---- Core API ----
API_HTTP_ADDR=:8080
# >= 32 chars; required in production.
SESSION_SECRET=
# 32 random bytes, base64 (encrypts OAuth tokens at rest); required in production.
DATA_ENCRYPTION_KEY=

# ---- AI service (internal) ----
AI_SERVICE_URL=http://localhost:8090
# Shared service token, >= 32 chars; required in production.
AI_SERVICE_TOKEN=
# auto | anthropic | openai | fake (fake = deterministic, tests/offline dev only; rejected in production)
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Object storage (Phase 2) ----
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=false

# ---- Gmail OAuth (Phase 7) ----
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5173/api/v1/integrations/gmail/callback
