# CareerPilot AI configuration template.
# Copy to .env and fill in values. Never commit .env. `make env` generates random secrets.

# ---- General ----
APP_ENV=development            # development | test | production (production enforces all secrets)
APP_VERSION=dev
LOG_LEVEL=info                 # debug | info | warn | error

# ---- Host ports (ADR-013) ----
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
API_HOST_PORT=8080
AI_HOST_PORT=8090
WEB_HOST_PORT=8088
S3_HOST_PORT=58333

# ---- PostgreSQL ----
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=careerpilot
# Used when running the API on the host (make dev-api):
DATABASE_URL=postgres://careerpilot:change-me@localhost:55432/careerpilot?sslmode=disable
DATABASE_MAX_CONNS=10

# ---- Redis (rate limits, caches; never authoritative) ----
REDIS_URL=redis://localhost:56379/0

# ---- Core API ----
API_HTTP_ADDR=:8080
# >= 32 chars; required in production.
SESSION_SECRET=
# 32 random bytes, base64 (encrypts OAuth tokens at rest); required in production.
DATA_ENCRYPTION_KEY=
# Public web origin used in password-reset links (host dev: Vite on 5173).
APP_BASE_URL=http://localhost:5173
# Origin used by the compose stack (nginx web on 8088).
COMPOSE_APP_BASE_URL=http://localhost:8088
# true only when the API sits behind a trusted reverse proxy (compose sets it for the api service).
TRUST_PROXY_HEADERS=false
# COOKIE_SECURE defaults to true in production and false otherwise.
# SESSION_IDLE_TTL=168h
# SESSION_ABSOLUTE_TTL=720h
# MAX_UPLOAD_BYTES=10485760

# ---- AI service (internal) ----
AI_SERVICE_URL=http://localhost:8090
# Shared service token, >= 32 chars; required in production.
AI_SERVICE_TOKEN=
# auto | anthropic | fake (fake = deterministic, tests/offline dev only; rejected in production).
# openai is planned but not implemented yet.
AI_PROVIDER=auto
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium               # low | medium | high | xhigh | max
ANTHROPIC_API_KEY=
# Embeddings for semantic matching (ADR-020): local | hash (tests only) | none
EMBEDDING_PROVIDER=local

# ---- Object storage (private, S3-compatible; SeaweedFS in compose) ----
# Host-run services use the published port; compose services use storage:8333.
S3_ENDPOINT=localhost:58333
S3_REGION=us-east-1
S3_BUCKET=careerpilot-documents
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret
S3_USE_SSL=false

# ---- Job discovery ----
# Full discovery cycle interval for the worker (0 disables scheduling; manual runs still work; min 15m).
DISCOVERY_INTERVAL=6h
# Insert the curated default job boards on API start (idempotent). Or run: careerpilot sources seed
SEED_JOB_SOURCES=true
# Identifies CareerPilot to job boards.
DISCOVERY_USER_AGENT=CareerPilotBot/0.1 (+job discovery; respects source terms)

# ---- Transactional email (password reset) ----
# Leave empty in development: emails are written to the API log instead. Required in production.
SMTP_ADDR=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Gmail (Phase 7, recruiter outreach) ---
# Create an OAuth client (type "Web application") in Google Cloud Console,
# enable the Gmail API, and add the redirect URI below to the client.
# Scopes requested: gmail.send and gmail.metadata (headers only).
# While the OAuth consent screen is in "Testing", only listed test users can
# connect; production use needs Google's app verification (restricted scopes).
# Requires DATA_ENCRYPTION_KEY (tokens are encrypted at rest).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Defaults to APP_BASE_URL + /api/v1/integrations/gmail/callback
# (Compose: http://localhost:8088/api/v1/integrations/gmail/callback).
GOOGLE_OAUTH_REDIRECT_URL=

# ---- Production readiness (Phase 10, ADR-026) ----
# Any secret can instead be read from a file: NAME_FILE=/run/secrets/name
# (Docker/Kubernetes secrets; setting both NAME and NAME_FILE is an error).
# Key rotation: new key in DATA_ENCRYPTION_KEY with a new version; the old key
# stays readable in DATA_ENCRYPTION_KEYS_RETIRED until `careerpilot keys rotate`.
DATA_ENCRYPTION_KEY_VERSION=1
DATA_ENCRYPTION_KEYS_RETIRED=
# Requests per minute per signed-in user (per IP when signed out); 0 disables.
API_RATE_LIMIT_PER_MINUTE=300
# Seconds readiness reports "draining" before the API stops accepting connections.
API_HTTP_SHUTDOWN_DRAIN=0s
# How long the worker lets running jobs finish on shutdown before cancelling them.
WORKER_SHUTDOWN_TIMEOUT=30s
# false: run `careerpilot migrate up` as a release step (multi-replica deployments).
MIGRATE_ON_START=true
# Create the bucket at startup (default true outside production; bundled storage).
# S3_CREATE_BUCKET=true
# Internal Prometheus listener (Compose sets :9100; never exposed publicly).
METRICS_ADDR=
# Tracing is off unless an OTLP/HTTP endpoint is set. With
# `make observability`: OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Observability UIs (loopback only): Prometheus, Alertmanager, Jaeger.
PROMETHEUS_HOST_PORT=59090
ALERTMANAGER_HOST_PORT=59093
JAEGER_HOST_PORT=56686
# Production overlay (deploy/compose.prod.yml): the public HTTPS origin.
# PUBLIC_BASE_URL=https://careerpilot.example.com
